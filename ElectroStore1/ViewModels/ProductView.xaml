<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ElectroStore1.ViewModels"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <DataTemplate DataType="{x:Type vm:ProductViewModel}">
        <Border CornerRadius="12"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="10"
                Margin="10"
                Background="White"
                Width="220">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Background="OrangeRed" CornerRadius="4" Padding="4,0" Margin="0,0,6,0">
                            <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}" 
                   Foreground="White" 
                   FontSize="12" 
                   FontWeight="Bold"/>
                        </Border>

                        <Border Background="#d000ff" CornerRadius="4" Padding="4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnSale}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="РАСПРОДАЖА" 
                   Foreground="White" 
                   FontSize="12" 
                   FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button Content="❤"
                            Background="Transparent"
                            Foreground="#FF4081"
                            FontSize="16"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Cursor="Hand"/>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Grid Height="140" Background="#F9F9F9" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Image Source="{Binding ImagePath}" Stretch="Uniform" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,10,0,2"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"/>

                    <TextBlock Text="{Binding Brand}"
                               Foreground="Gray"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:N0} ₽}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FF5722"/>
                        <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N0} ₽}"
                                   Margin="8,0,0,0"
                                   TextDecorations="Strikethrough"
                                   Foreground="Gray"
                                   FontSize="12"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="★" Foreground="Gold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rating}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rating}" Value="6">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Rating}" Margin="4,0,0,0" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rating}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Rating}" Value="6">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Foreground="Gray" FontSize="12" Margin="4,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding ReviewsCount, StringFormat='· {0} отзывов'}"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Rating}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Нет отзывов"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Rating}" Value="6"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="Нет отзывов"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Foreground="#FF5722"
                               FontSize="12"
                               Margin="0,0,0,6">
                        <Run Text="Осталось"/>
                        <Run Text="{Binding StockCount}"/>
                        <Run Text="шт."/>
                    </TextBlock>

                    <Button Content="В корзину"
                            Height="32"
                            Background="#03A9F4"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>