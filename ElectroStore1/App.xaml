<Application x:Class="ElectroStore1.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ElectroStore1"
             StartupUri="/Pages/Authorization.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="TextColor" Color="#FF0600C8"/>
            <SolidColorBrush x:Key="SecondaryTextColor" Color="#757575"/>
            <SolidColorBrush x:Key="ButtonBackgroundColor" Color="#03A9F4"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
