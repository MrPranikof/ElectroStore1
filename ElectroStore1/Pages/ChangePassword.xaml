<Window x:Class="ElectroStore1.Pages.ChangePassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена пароля" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2d3436"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="InputField" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#dfe6e9"/>
            <Setter Property="Background" Value="#f5f6fa"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#206C5CE7"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5649C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#4539A8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#00CEc9"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#2000CEc9"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00B5B2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#f5f6fa">
        <!-- Фоновые элементы -->
        <Ellipse Fill="#6C5CE7" Opacity="0.08" Width="300" Height="300"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
        <Ellipse Fill="#00CEc9" Opacity="0.08" Width="250" Height="250"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>

        <!-- Основная форма -->
        <Grid Width="550" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border CornerRadius="20" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#20000000"/>
                </Border.Effect>

                <StackPanel VerticalAlignment="Center" Margin="40">
                    <TextBlock Text="Смена пароля" FontSize="24" Foreground="#2d3436" 
                              HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,30"/>

                    <!-- Текущий пароль -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Текущий пароль" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border Style="{StaticResource InputField}">
                            <TextBox x:Name="OldPasswordBox" BorderThickness="0" Background="Transparent"
                                       Padding="10,8" FontSize="14" Foreground="#2d3436"
                                       Height="35" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Новый пароль -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Новый пароль" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border Style="{StaticResource InputField}">
                            <Grid>
                                <PasswordBox x:Name="NewPasswordBox" BorderThickness="0" Background="Transparent"
                        Padding="10,8" FontSize="14" Foreground="#2d3436"
                        Height="35" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="NewPasswordTextBox" BorderThickness="0" Background="Transparent"
                     Padding="10,8" FontSize="14" Foreground="#2d3436" Visibility="Collapsed"
                     Height="35" VerticalContentAlignment="Center"/>
                                <Button x:Name="ToggleNewPasswordButton" HorizontalAlignment="Right" 
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    Background="Transparent" BorderThickness="0"
                    Click="ToggleNewPasswordVisibility" Width="30" Height="30">
                                    <Image Source="/Images/showpassword.png"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Подтверждение пароля -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Подтвердите пароль" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border Style="{StaticResource InputField}">
                            <Grid>
                                <PasswordBox x:Name="ConfirmPasswordBox" BorderThickness="0" Background="Transparent"
                        Padding="10,8" FontSize="14" Foreground="#2d3436"
                        Height="35" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="ConfirmPasswordTextBox" BorderThickness="0" Background="Transparent"
                     Padding="10,8" FontSize="14" Foreground="#2d3436" Visibility="Collapsed"
                     Height="35" VerticalContentAlignment="Center"/>
                                <Button x:Name="ToggleConfirmPasswordButton" HorizontalAlignment="Right" 
                    VerticalAlignment="Center" Margin="0,0,10,0"
                    Background="Transparent" BorderThickness="0"
                    Click="ToggleConfirmPasswordVisibility"  Width="30" Height="30">
                                    <Image Source="/Images/showpassword.png"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Кнопки действий -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" 
                               Click="CancelButton_Click" Margin="0,0,15,0"/>
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" 
                               Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>