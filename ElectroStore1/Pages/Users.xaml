<Window x:Class="ElectroStore1.Pages.Users"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
        xmlns:converters="clr-namespace:ElectroStore1.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Пользователи" Height="600" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        >

    <Window.Resources>
        <converters:NullToTextConverter x:Key="NullToTextConverter" DefaultText="Не указано"/>
    </Window.Resources>
    <Grid Background="{StaticResource BackgroundLight}">
        <Border Background="White" 
                Height="70" 
                VerticalAlignment="Top"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox" 
                            Width="450" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SearchTextBoxStyle}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="🔍 Поиск" 
                           Click="SearchButton_Click"
                           Width="120"
                           Style="{StaticResource ModernButton}"
                           IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Margin="20,90,20,80" 
                Background="White" 
                CornerRadius="6"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#20000000" 
                                 Direction="270" 
                                 ShadowDepth="3" 
                                 Opacity="0.15" 
                                 BlurRadius="8"/>
            </Border.Effect>
            <DataGrid x:Name="UserDG"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      Margin="0"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="{StaticResource BorderLight}">

                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" 
                                       Binding="{Binding UserId}" 
                                       IsReadOnly="True"
                                       Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Логин -->
                    <DataGridTextColumn Header="ЛОГИН" 
                                       Binding="{Binding Username, Converter={StaticResource NullToTextConverter}}"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Email -->
                    <DataGridTextColumn Header="EMAIL" 
                                       Binding="{Binding Email, Converter={StaticResource NullToTextConverter}}"
                                       Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Имя -->
                    <DataGridTextColumn Header="ИМЯ" 
                                       Binding="{Binding FirstName, Converter={StaticResource NullToTextConverter}}"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Фамилия -->
                    <DataGridTextColumn Header="ФАМИЛИЯ" 
                                       Binding="{Binding LastName, Converter={StaticResource NullToTextConverter}}"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Роль -->
                    <DataGridComboBoxColumn Header="РОЛЬ"
                       SelectedValueBinding="{Binding RoleId, UpdateSourceTrigger=PropertyChanged}"
                       DisplayMemberPath="RoleName"
                       SelectedValuePath="RoleId"
                       Width="120">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxElementStyle}">
                                <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.Roles}"/>
                                <Setter Property="SelectedValue" Value="{Binding RoleId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxElementStyle}">
                                <Setter Property="ItemsSource" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.Roles}"/>
                                <Setter Property="SelectedValue" Value="{Binding RoleId, UpdateSourceTrigger=PropertyChanged}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- Дата рождения -->
                    <DataGridTextColumn Header="Д.Р." 
                   Binding="{Binding DateOfBirth, StringFormat='{}{0:dd.MM.yyyy}', Converter={StaticResource NullToTextConverter}}"
                   Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Пол -->
                    <DataGridTextColumn Header="ПОЛ" 
                                       Binding="{Binding Gender, Converter={StaticResource NullToTextConverter}}"
                                       Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Телефон -->
                    <DataGridTextColumn Header="ТЕЛЕФОН" 
                                       Binding="{Binding Phone, Converter={StaticResource NullToTextConverter}}"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Последний вход -->
                    <DataGridTextColumn Header="ПОСЛ. ВХОД" 
                                       Binding="{Binding LastLoginDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Converter={StaticResource NullToTextConverter}, ConverterParameter='Не входил'}"
                                       IsReadOnly="True"
                                       Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Создан -->
                    <DataGridTextColumn Header="СОЗДАН" 
                                       Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                       IsReadOnly="True"
                                       Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Обновлен -->
                    <DataGridTextColumn Header="ОБНОВЛЕН" 
                                       Binding="{Binding UpdatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}', Converter={StaticResource NullToTextConverter}, ConverterParameter='Не обновлялся'}"
                                       IsReadOnly="True"
                                       Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Панель с кнопками внизу -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Margin="30,0,0,30">

            <Button Content="✏ СОХРАНИТЬ" 
                    Name="EditSelectedButton"
                    Width="180" 
                    Height="42" 
                    Click="EditSelectedButton_Click"
                    FontSize="14">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45a049"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="🗑 УДАЛИТЬ" 
                    Name="DeleteSelectedButton"
                    Width="180" 
                    Height="42" 
                    Click="DeleteSelectedButton_Click"
                    FontSize="14"
                    Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#FF5252"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Кнопка ЭКСПОРТ -->
            <Button Content="📤 ЭКСПОРТ" 
                    Name="ExportButton"
                    Width="180" 
                    Height="42" 
                    Click="ExportButton_Click"
                    FontSize="14"
                    Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#9B59B6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8E44AD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Popup x:Name="ExportPopup" 
               PlacementTarget="{Binding ElementName=ExportButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White" 
                    BorderBrush="{StaticResource BorderLight}" 
                    BorderThickness="1" 
                    CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect Color="#20000000" 
                                     Direction="270" 
                                     ShadowDepth="5" 
                                     Opacity="0.3" 
                                     BlurRadius="10"/>
                </Border.Effect>

                <StackPanel Margin="20">
                    <TextBlock Text="Выберите формат экспорта:" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="📊 Excel" 
                                Width="100" 
                                Height="40" 
                                Click="ExportToExcel_Click"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#229954"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📄 CSV" 
                                Width="100" 
                                Height="40" 
                                Click="ExportToCSV_Click"
                                Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#F39C12"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D68910"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📝 Word" 
                                Width="100" 
                                Height="40" 
                                Click="ExportToWord_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#3498DB"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
