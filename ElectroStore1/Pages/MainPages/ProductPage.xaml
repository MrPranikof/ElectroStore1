<Page x:Class="ElectroStore1.Pages.MainPages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage"
      >

    <ScrollViewer Background="#FAFAFA">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 🖼 Изображение товара -->
            <Border Background="White" CornerRadius="12" Padding="10" Margin="10">
                <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
            </Border>

            <!-- 📄 Описание и детали -->
            <StackPanel Grid.Column="1" Margin="20,10,0,10">
                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Brand}" FontSize="14" Foreground="Gray" Margin="0,4"/>
                <TextBlock Text="{Binding Description}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,10"/>

                <!-- 💰 Цена -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:C}}"
                               FontSize="24" FontWeight="Bold" Foreground="#FF5722"/>
                    <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:C}}"
                               Margin="10,0,0,0" TextDecorations="Strikethrough"
                               Foreground="Gray" FontSize="16" VerticalAlignment="Bottom"/>
                </StackPanel>

                <!-- 📦 Остаток -->
                <TextBlock Text="{Binding StockText}" Foreground="#FF5722" FontSize="13" Margin="0,0,0,10"/>

                <!-- 🛒 Кнопка "Добавить в корзину" -->
                <Button Content="Добавить в корзину"
                        Background="#03A9F4"
                        Foreground="White"
                        FontWeight="Bold"
                        Height="40"
                        Cursor="Hand"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        Width="200">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
