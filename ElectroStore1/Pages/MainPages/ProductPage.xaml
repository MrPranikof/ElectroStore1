<Page x:Class="ElectroStore1.Pages.MainPages.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
      xmlns:vm="clr-namespace:ElectroStore1.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">
    <Grid Background="White">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40">
                <!-- Кнопка назад -->
                <Button Content="← Назад к товарам" 
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"
                        Click="BackButton_Click"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="14"
                        Foreground="#03A9F4"/>

                <!-- Основной контент -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="#F9F9F9" 
                            CornerRadius="8"
                            Padding="20"
                            MaxHeight="400"
                            VerticalAlignment="Top"
                            >
                        <Image Source="{Binding ProductImage}" 
                               MaxHeight="400"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Информация о товаре -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Name}" 
                                   FontSize="28" 
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding Brand}" 
                                   FontSize="18"
                                   Foreground="Gray" 
                                   Margin="0,0,0,20"/>

                        <!-- Рейтинг -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="★★★★★" 
                                       Foreground="Gold" 
                                       FontSize="16"/>
                            <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" 
                                       Margin="10,0,0,0" 
                                       FontSize="16"/>
                            <TextBlock Text="{Binding ReviewsCount, StringFormat='({0} отзывов)'}" 
                                       Margin="10,0,0,0" 
                                       Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:N0} ₽}" 
                                       FontSize="32" 
                                       FontWeight="Bold" 
                                       Foreground="#FF5722"/>

                            <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N0} ₽}" 
                                       FontSize="20"
                                       TextDecorations="Strikethrough"
                                       Foreground="Gray"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Bottom">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountPercent}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="OrangeRed"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DiscountPercent}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}" 
                                           Foreground="White" 
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Наличие -->
                        <TextBlock Foreground="#4CAF50"
                                   FontSize="14"
                                   Margin="0,0,0,10">
                            <Run Text="✓ В наличии:"/>
                            <Run Text="{Binding StockCount}"/>
                            <Run Text="шт."/>
                        </TextBlock>

                        <TextBlock Text="{Binding Description}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,20"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Button Content="Добавить в корзину" 
                                    Height="45"
                                    Width="200"
                                    Background="#03A9F4"
                                    Foreground="White"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Margin="0,0,10,0"
                                    Click="AddToCart_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StockCount}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="LightGray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="FavoriteButton"
                                    Content="♥" 
                                    Height="45"
                                    Width="45"
                                    Background="White"
                                    BorderBrush="#FF4081"
                                    BorderThickness="2"
                                    Foreground="#FF4081"
                                    FontSize="20"
                                    Cursor="Hand"
                                    Click="AddToFavorites_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FF4081"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                <Setter Property="Background" Value="#FF4081"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <Border BorderBrush="#E0E0E0" 
        BorderThickness="0,1,0,0" 
        Margin="0,40,0,0" 
        Grid.ColumnSpan="3">
                            <StackPanel Margin="0,30,0,0">
                                <TextBlock Text="Отзывы" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

                                <!-- Форма добавления отзыва -->
                                <Border Background="#F5F5F5" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,30">
                                    <StackPanel>
                                        <TextBlock Text="Оставить отзыв" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,15"/>

                                        <!-- Рейтинг -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <TextBlock Text="Ваша оценка:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"/>
                                            <ItemsControl x:Name="RatingStars">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="★" 
                    FontSize="24" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    Tag="{Binding}"
                    Click="StarRating_Click">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Foreground" Value="LightGray"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="Gold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Текст отзыва -->
                                        <TextBox x:Name="ReviewTextBox" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         Height="100" 
                         Padding="10"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"
                         Margin="0,0,0,15">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="#03A9F4"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Button Content="Отправить отзыв" 
                        Height="40"
                        Width="150"
                        HorizontalAlignment="Left"
                        Background="#03A9F4"
                        Foreground="White"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="SubmitReview_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Список отзывов -->
                                <ItemsControl x:Name="ReviewsList" 
                      ItemsSource="{Binding Reviews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFAFA" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,15">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Text="{Binding UserName}" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Margin="0,0,15,0"/>
                                                            <TextBlock Text="{Binding RatingStars}" 
                                               Foreground="Gold" 
                                               FontSize="14"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="1" 
                                           Text="{Binding ReviewDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                           Foreground="Gray" 
                                           FontSize="12"/>
                                                    </Grid>

                                                    <!-- Текст отзыва -->
                                                    <TextBlock Grid.Row="1" 
                                       Text="{Binding ReviewText}" 
                                       TextWrapping="Wrap" 
                                       FontSize="14" 
                                       Margin="0,0,0,10"/>

                                                    <Button Grid.Row="2" 
                                    Content="Удалить" 
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    Foreground="Red"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Tag="{Binding ReviewId}"
                                    Click="DeleteReview_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentUserReview}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Пока нет отзывов. Будьте первым!" 
                   FontSize="14" 
                   Foreground="Gray" 
                   HorizontalAlignment="Center" 
                   Margin="0,20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Reviews.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>