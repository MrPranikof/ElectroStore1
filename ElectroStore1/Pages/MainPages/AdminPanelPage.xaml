<Page x:Class="ElectroStore1.Pages.MainPages.AdminPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPanelPage">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel Width="200">
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddProduct_Click" Width="150">Добавление товара</Button>
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddCategory_Click" Width="150">Добавление категории</Button>
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddBrand_Click" Width="150">Добавление бренда</Button>
            </StackPanel>
            <StackPanel Width="200">
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddProduct_Click" Width="150">Редактирование товаров</Button>
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddProduct_Click" Width="150">Редактирование категорий</Button>
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddProduct_Click" Width="150">Редактирование брендов</Button>
            </StackPanel>
            <StackPanel Width="200">
                <Button HorizontalAlignment="Left" Margin="10,10" Click="AddProduct_Click" Width="150">Работа с пользователями</Button>
            </StackPanel>
            <StackPanel Width="200">
            </StackPanel>
        </StackPanel>
        
    </Grid>
</Page>
