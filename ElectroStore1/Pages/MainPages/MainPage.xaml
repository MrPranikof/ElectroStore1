<Page x:Class="ElectroStore1.Pages.MainPages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
      xmlns:vm="clr-namespace:ElectroStore1.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="MainPage">

    <Page.Resources>
        <DataTemplate DataType="{x:Type vm:ProductViewModel}">
            <Border CornerRadius="12"
                BorderBrush="#DDD"
                BorderThickness="1"
                Padding="10"
                Margin="10"
                Background="White"
                Width="220">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Border Background="OrangeRed"
                                CornerRadius="4"
                                Padding="4,0"
                                Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountPercent}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding DiscountPercent, StringFormat=-{0}%}" 
                                                   Foreground="White" 
                                                   FontSize="12" 
                                                   FontWeight="Bold"/>
                                </Border>

                                <Border Background="#d000ff" CornerRadius="4" Padding="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnSale}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="РАСПРОДАЖА" 
                   Foreground="White" 
                   FontSize="12" 
                   FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        <Button Content="❤" 
                                Background="Transparent"
                                FontSize="16"
                                BorderThickness="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                Click="ToggleFavourite_Click"
                                Tag="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="Gray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                            <Setter Property="Foreground" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                        <StackPanel Grid.Row="1">
                            <Grid Height="140" Background="#F9F9F9" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Button Background="Transparent" 
        BorderThickness="0" 
        Cursor="Hand"
        Click="ProductImage_Click"
        Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Image Source="{Binding ProductImage}" 
           Stretch="Uniform" 
           VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,10,0,2"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Left"/>

                            <TextBlock Text="{Binding Brand}"
                               Foreground="Gray"
                               FontSize="12"
                               Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DiscountedPrice, StringFormat={}{0:N0} ₽}"
               FontSize="16"
               FontWeight="Bold"
               Foreground="#FF5722"/>

                                <TextBlock Text="{Binding OriginalPrice, StringFormat={}{0:N0} ₽}"
               Margin="8,0,0,0"
               TextDecorations="Strikethrough"
               Foreground="Gray"
               FontSize="12"
               VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiscountPercent}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="★" Foreground="Gold" FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rating}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Rating, StringFormat={}{0:F1}}" Margin="4,0,0,0" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rating}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Foreground="Gray" FontSize="12" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ReviewsCount, StringFormat='· {0} отзывов'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ReviewsCount}" Value="0">
                                                <Setter Property="Text" Value="Нет отзывов"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Foreground="#FF5722"
                               FontSize="12"
                               Margin="0,0,0,6">
                        <Run Text="Осталось"/>
                        <Run Text="{Binding StockCount}"/>
                        <Run Text="шт."/>
                            </TextBlock>

                            <Button Content="В корзину"
                            Height="32"
                            Background="#03A9F4"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            Click="AddToCart_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
    </Page.Resources>


    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="20" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="Рекомендации" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecommendedProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Rectangle Grid.Row="2" Height="20" Fill="Transparent"/>

                <Label Grid.Row="3" Content="Скидки" 
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>

                <ItemsControl Grid.Row="4" ItemsSource="{Binding DiscountProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
