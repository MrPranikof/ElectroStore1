<Page x:Class="ElectroStore1.Pages.MainPages.BasketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Корзина" Width="800"
      Background="{StaticResource LightGrayBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="15">
            <TextBlock Text="Корзина" 
                      Foreground="White" 
                      FontSize="22" 
                      FontWeight="Bold"/>
        </Border>

        <ListView x:Name="CartListView" 
                 Grid.Row="1" 
                 Margin="10,0"
                 Background="White"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource CartItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                               Width="80" 
                               Height="80" 
                               Background="#F1F1F1" 
                               CornerRadius="5"
                               Margin="10">
                            <Image Source="{Binding Image}" Stretch="Uniform"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" 
                                      FontSize="16" 
                                      FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Brand}" 
                                      Foreground="{StaticResource DarkGrayBrush}" 
                                      Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" 
                                  Text="{Binding Price, StringFormat={}{0}₽}" 
                                  FontSize="16"
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="3" 
                                   Orientation="Horizontal" 
                                   VerticalAlignment="Center">
                            <Button Content="-" 
                                   Style="{StaticResource QuantityButtonStyle}"
                                   Click="DecreaseQuantity_Click" 
                                   Tag="{Binding}"/>
                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource QuantityTextBoxStyle}"/>
                            <Button Content="+" 
                                   Style="{StaticResource QuantityButtonStyle}"
                                   Click="IncreaseQuantity_Click" 
                                   Tag="{Binding}"/>
                        </StackPanel>

                        <Button Grid.Column="4" 
                               Content="✕" 
                               Style="{StaticResource RemoveButtonStyle}"
                               Click="RemoveItem_Click"
                               Tag="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="2" 
               Background="White" 
               BorderBrush="{StaticResource MediumGrayBrush}" 
               BorderThickness="0,1,0,0" 
               Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Итого:" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Margin="0,0,10,0"/>
                        <TextBlock x:Name="TotalText" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Назад" 
                               Style="{StaticResource SecondaryButtonStyle}"
                               Margin="0,0,10,0"
                               Click="BackButton_Click"/>
                        <Button Content="Оформить заказ" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Click="CheckoutButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>