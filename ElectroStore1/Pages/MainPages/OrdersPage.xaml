<Page x:Class="ElectroStore.Pages.MainPages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Мои заказы"
      Unloaded="Page_Unloaded">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Мои заказы" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="20,10,20,20"/>

        <!-- Список заказов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="OrdersItemsControl" ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    CornerRadius="8" 
                                    Margin="20,0,20,15"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#20000000" 
                                                     Direction="270" 
                                                     ShadowDepth="2" 
                                                     Opacity="0.1" 
                                                     BlurRadius="5"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Шапка заказа -->
                                    <Border Grid.Row="0" 
                                            Background="#F8F9FA" 
                                            CornerRadius="8,8,0,0"
                                            Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock FontSize="16" FontWeight="SemiBold">
                                                    <Run Text="Заказ №"/>
                                                    <Run Text="{Binding OrderId}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding OrderDate, StringFormat='от {0:dd MMMM yyyy г. в HH:mm}'}" 
                                                          Foreground="#666" 
                                                          FontSize="13"
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" 
                                                    CornerRadius="4"
                                                    Padding="10,5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Новый">
                                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="В обработке">
                                                                <Setter Property="Background" Value="#FFF3E0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Отправлен">
                                                                <Setter Property="Background" Value="#F3E5F5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Доставлен">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Отменен">
                                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" 
                                                          FontWeight="SemiBold"
                                                          FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Новый">
                                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="В обработке">
                                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Отправлен">
                                                                    <Setter Property="Foreground" Value="#7B1FA2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Доставлен">
                                                                    <Setter Property="Foreground" Value="#388E3C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Отменен">
                                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Товары в заказе -->
                                    <ItemsControl Grid.Row="1" 
                                                 ItemsSource="{Binding OrderItems}"
                                                 Margin="20,15">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" 
        Width="50" 
        Height="50"
        CornerRadius="4"
        Background="#F5F5F5">
                                                        <Image Source="{Binding ProductImageSource}" 
           Stretch="Uniform"
           Margin="5"/>
                                                    </Border>
                                                    <!-- Информация о товаре -->
                                                    <StackPanel Grid.Column="1" 
                                                               Margin="15,0,0,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductName}" 
                                                                  FontWeight="SemiBold"
                                                                  FontSize="14"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Foreground="#666" 
                                                                  FontSize="12"
                                                                  Margin="0,2,0,0">
                                                            <Run Text="{Binding Quantity}"/>
                                                            <Run Text="шт. ×"/>
                                                            <Run Text="{Binding Price, StringFormat='{}{0:N0} ₽'}"/>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <!-- Сумма -->
                                                    <TextBlock Grid.Column="2" 
                                                              Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}"
                                                              FontWeight="SemiBold"
                                                              FontSize="14"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Итоговая информация -->
                                    <Border Grid.Row="2" 
                                            Background="#FAFAFA" 
                                            CornerRadius="0,0,8,8"
                                            Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DeliveryAddress}" 
               FontSize="13"
               Foreground="#666"
               TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding PaymentMethod, StringFormat='Оплата: {0}'}" 
               FontSize="13"
               Foreground="#666"
               Margin="0,5,0,0"/>
                                                <!-- Дата доставки (показывается только если есть значение) -->
                                                <TextBlock Text="{Binding DeliveryDate, StringFormat='Дата доставки: {0:dd.MM.yyyy}'}" 
               FontSize="13"
               Foreground="#666"
               Margin="0,5,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" 
                                                       HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right">
                                                    <Run Text="Итого:" FontSize="14"/>
                                                    <Run Text="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}" 
                                                         FontSize="18" 
                                                         FontWeight="Bold"
                                                         Foreground="#FF5722"/>
                                                </TextBlock>

                                                <Button Content="Повторить заказ" 
                                                        Margin="0,10,0,0"
                                                        Padding="15,8"
                                                        Background="#03A9F4"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="RepeatOrder_Click"
                                                        Tag="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                               CornerRadius="4"
                                                                               Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Отменен">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Сообщение о пустом списке -->
                <TextBlock x:Name="EmptyOrdersText"
                          Text="У вас пока нет заказов"
                          FontSize="18"
                          HorizontalAlignment="Center"
                          Margin="20,50"
                          Foreground="#999"
                          Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>