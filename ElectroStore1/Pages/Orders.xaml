<Window x:Class="ElectroStore1.Pages.MainPages.Orders"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ElectroStore1.Pages.MainPages"
        Title="Управление заказами" Height="700" Width="1200"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <x:Array x:Key="OrderStatuses" Type="{x:Type sys:String}">
            <sys:String>Новый</sys:String>
            <sys:String>В обработке</sys:String>
            <sys:String>Отправлен</sys:String>
            <sys:String>Доставлен</sys:String>
            <sys:String>Отменен</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundLight}">
        <Border Background="White" 
                Height="70" 
                VerticalAlignment="Top"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox" 
                            Width="450" 
                            Margin="0,0,10,0"
                            Style="{StaticResource SearchTextBoxStyle}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Content="🔍 Поиск" 
                           Click="SearchButton_Click"
                           Width="120"
                           Style="{StaticResource ModernButton}"
                           IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная таблица заказов -->
        <Border Margin="20,90,20,300" 
                Background="White" 
                CornerRadius="6"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#20000000" 
                                 Direction="270" 
                                 ShadowDepth="3" 
                                 Opacity="0.15" 
                                 BlurRadius="8"/>
            </Border.Effect>
            <DataGrid x:Name="OrdersDG"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      Margin="0"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="{StaticResource BorderLight}">

                <DataGrid.Columns>
                    <!-- ID -->
                    <DataGridTextColumn Header="ID" 
                                       Binding="{Binding OrderId}" 
                                       IsReadOnly="True"
                                       Width="60">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ПОЛЬЗОВАТЕЛЬ -->
                    <DataGridTextColumn Header="ПОЛЬЗОВАТЕЛЬ" 
                                       Binding="{Binding UserName}"
                                       IsReadOnly="True"
                                       Width="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ДАТА ЗАКАЗА -->
                    <DataGridTextColumn Header="ДАТА ЗАКАЗА" 
                                       Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                                       IsReadOnly="True"
                                       Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>



                    <DataGridTemplateColumn Header="ДАТА ДОСТАВКИ" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeliveryDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeliveryDate}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="{StaticResource InactiveTextColor}"/>
                                                    <Setter Property="Text" Value="—"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding DeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                       BorderThickness="0"
                       Padding="0"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    
                    <!-- СУММА -->
                    <DataGridTextColumn Header="СУММА" 
                                       Binding="{Binding TotalAmount, StringFormat='{}{0:0} ₽'}" 
                                       IsReadOnly="True"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- СТАТУС -->
                    <DataGridComboBoxColumn Header="СТАТУС" 
                                          SelectedValueBinding="{Binding Status}" 
                                          Width="140">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxElementStyle}">
                                <Setter Property="ItemsSource" Value="{StaticResource OrderStatuses}"/>
                                <Setter Property="IsEditable" Value="False"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxElementStyle}">
                                <Setter Property="ItemsSource" Value="{StaticResource OrderStatuses}"/>
                                <Setter Property="IsEditable" Value="False"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- ТРЕК-НОМЕР -->
                    <DataGridTextColumn Header="ТРЕК-НОМЕР" 
                                       Binding="{Binding TrackingNumber, TargetNullValue='нет'}" 
                                       Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TrackingNumber}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{StaticResource InactiveTextColor}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- СТАТУС ОПЛАТЫ -->
                    <DataGridTextColumn Header="СТАТУС ОПЛАТЫ" 
                                       Binding="{Binding PaymentStatus}" 
                                       IsReadOnly="True"
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- СОЗДАН -->
                    <DataGridTextColumn Header="СОЗДАН" 
                                       Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       IsReadOnly="True"
                                       Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ОБНОВЛЁН -->
                    <DataGridTextColumn Header="ОБНОВЛЁН" 
                                       Binding="{Binding UpdatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                       IsReadOnly="True"
                                       Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdatedAt}" Value="{x:Null}">
                                        <Setter Property="Foreground" Value="{StaticResource InactiveTextColor}"/>
                                        <Setter Property="Text" Value="—"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Таблица позиций заказа -->
        <Border Margin="20,420,20,80" 
                Background="White" 
                CornerRadius="6"
                BorderBrush="{StaticResource BorderLight}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#20000000" 
                                 Direction="270" 
                                 ShadowDepth="3" 
                                 Opacity="0.15" 
                                 BlurRadius="8"/>
            </Border.Effect>
            <DataGrid x:Name="OrderItemsDG"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      Margin="0"
                      VerticalGridLinesBrush="Transparent"
                      HorizontalGridLinesBrush="{StaticResource BorderLight}">

                <DataGrid.Columns>
                    <!-- ID ПОЗИЦИИ -->
                    <DataGridTextColumn Header="ID ПОЗИЦИИ" 
                                       Binding="{Binding OrderItemId}" 
                                       Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ТОВАР -->
                    <DataGridTextColumn Header="ТОВАР" 
                                       Binding="{Binding ProductName}" 
                                       Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,5"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- КОЛИЧЕСТВО -->
                    <DataGridTextColumn Header="КОЛИЧЕСТВО" 
                                       Binding="{Binding Quantity}" 
                                       Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- ЦЕНА -->
                    <DataGridTextColumn Header="ЦЕНА" 
                                       Binding="{Binding Price, StringFormat='{}{0:0} ₽'}" 
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- СУММА -->
                    <DataGridTextColumn Header="СУММА" 
                                       Binding="{Binding TotalPrice, StringFormat='{}{0:0} ₽'}" 
                                       Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignedCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Панель с кнопками внизу -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Margin="30,0,0,30">

            <Button Content="✏ СОХРАНИТЬ" 
                    Width="180" 
                    Height="42" 
                    Click="SaveButton_Click"
                    FontSize="14"
                    Margin="0,0,10,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#4CAF50"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45a049"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="🗑 УДАЛИТЬ" 
                    Width="180" 
                    Height="42" 
                    Click="DeleteButton_Click"
                    FontSize="14"
                    Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#FF5252"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="📤 ЭКСПОРТ" 
    Name="ExportButton"
    Width="180" 
    Height="42" 
    Click="ExportButton_Click"
    FontSize="14"
    Margin="10,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                        <Setter Property="Background" Value="#9B59B6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8E44AD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Popup x:Name="ExportPopup" 
       PlacementTarget="{Binding ElementName=ExportButton}"
       Placement="Top"
       StaysOpen="False"
       AllowsTransparency="True">
            <Border Background="White" 
            BorderBrush="{StaticResource BorderLight}" 
            BorderThickness="1" 
            CornerRadius="6"
            Padding="10">
                <Border.Effect>
                    <DropShadowEffect Color="#20000000" 
                             Direction="270" 
                             ShadowDepth="5" 
                             Opacity="0.3" 
                             BlurRadius="10"/>
                </Border.Effect>

                <StackPanel Margin="20">
                    <TextBlock Text="Выберите формат экспорта:" 
                      FontSize="16" 
                      FontWeight="SemiBold"
                      Margin="0,0,0,15"
                      HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="📊 Excel" 
                        Width="100" 
                        Height="40" 
                        Click="ExportToExcel_Click"
                        Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#27AE60"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#229954"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📄 CSV" 
                        Width="100" 
                        Height="40" 
                        Click="ExportToCSV_Click"
                        Margin="0,0,10,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#F39C12"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D68910"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="📝 Word" 
                        Width="100" 
                        Height="40" 
                        Click="ExportToWord_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Background" Value="#3498DB"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>