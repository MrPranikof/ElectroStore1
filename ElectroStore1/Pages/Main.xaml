<Window x:Class="ElectroStore1.Pages.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="1200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid Background="{StaticResource BackgroundColor}">
        <Grid x:Name="Header" Height="50" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <TextBlock Text="ElectroStore" FontSize="32" Foreground="{StaticResource TextColor}"/>
                <TextBox x:Name="SearchTextBox" Width="600" Margin="10,5,0,5">Поиск</TextBox>
                <Button>Поиск</Button>
                <Button>Корзина</Button>
                <Button>Избранное</Button>
                <Button>Доставки</Button>
                <Button>Профиль</Button>
            </StackPanel>
        </Grid>
        
        <Grid Margin="5,54,5,0" Height="50" VerticalAlignment="Top" x:Name="Navigation">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CatalogButton" Grid.Column="0" MouseEnter="CatalogButton_Enter" MouseLeave="UIElement_Leave" Background="{StaticResource ButtonBackgroundColor}" Foreground="{StaticResource TextColor}" Click="CatalogButton_Click">Каталог</Button>
            <Button x:Name="AdminPanelButton" Grid.Column="3" MouseEnter="AdminPanelButton_Enter" MouseLeave="UIElement_Leave" Background="{StaticResource ButtonBackgroundColor}" Foreground="{StaticResource TextColor}">Админ панель</Button>
        </Grid>
        <Canvas x:Name="canvasCatalog" Background="White" Visibility="Collapsed" Margin="5,101,0,0" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave" Height="50" VerticalAlignment="Top">
            <Label>
                <Hyperlink>Смартфоны и гаджеты</Hyperlink>
            </Label>
        </Canvas>
        <Canvas x:Name="canvasFavourites" Background="White" Visibility="Collapsed" Margin="5,105,5,0" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave" Height="50" VerticalAlignment="Top">
        </Canvas>
        <Canvas x:Name="canvasBasket" Background="White" Visibility="Collapsed" Margin="5,105,5,0" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave" Height="50" VerticalAlignment="Top">
        </Canvas>
        <Canvas x:Name="canvasAdminPanel" Background="White" Visibility="Collapsed" Margin="5,105,5,0" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave" Height="50" VerticalAlignment="Top">
        </Canvas>

        <Frame x:Name="MainFrame" Margin="0,150,0,0"/>
    </Grid>
</Window>
