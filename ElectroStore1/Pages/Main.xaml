<Window x:Class="ElectroStore1.Pages.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages"
        mc:Ignorable="d"
        Title="Main" Height="600" Width="1200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid>
        <Grid VerticalAlignment="Top" Background="{StaticResource BackgroundColor}" Height="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="600"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="20,0" FontSize="28" Foreground="{StaticResource TextColor}" Cursor="Hand" MouseLeftButtonUp="GoToMain_Click">ElectroStore</TextBlock>

            <TextBox Grid.Column="2" x:Name="SearchTextBox" VerticalAlignment="Center" Height="30" Margin="10,0" GotFocus="SearchTextBox_GotFocus" LostFocus="SearchTextBox_LostFocus" FontSize="20">Поиск</TextBox>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="3">
                <Button Margin="5,0,70,0" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BackgroundColor}" FontSize="24" Click="Search_Button">🔍</Button>
                <Button Margin="5,0" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BackgroundColor}" FontSize="24" Click="Basket_Button">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center">🛒</TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center">Корзина</TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="5,0" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BackgroundColor}" Foreground="Red" FontSize="24" Click="Favourites_Button">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center">♥️</TextBlock>
                        <TextBlock FontSize="12" Foreground="Black" HorizontalAlignment="Center">Избранное</TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="5,0" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BackgroundColor}" FontSize="24" Click="Delivery_Button">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center">📦</TextBlock>
                        <TextBlock FontSize="12" HorizontalAlignment="Center">Доставки</TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="5,0" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BackgroundColor}" FontSize="24" Click="Profile_Button">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center">🙎‍♂️</TextBlock>
                        <TextBlock FontSize="12">Профиль</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Height="50" VerticalAlignment="Top" Margin="0,60,0,0" x:Name="GridMenu">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="CatalogCol"/>
                <ColumnDefinition Width="*" x:Name="AdminCol"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CatalogButton" Grid.Column="0" Background="{StaticResource ButtonBackgroundColor}" Foreground="{StaticResource ButtonTextColor}" Click="CatalogButton_Click" FontSize="16" FontWeight="Bold">Каталог</Button>
            <Button x:Name="AdminPanelButton" Grid.Column="1" Background="{StaticResource ButtonBackgroundColor}" Foreground="{StaticResource ButtonTextColor}" FontSize="16" FontWeight="Bold" Click="AdminPanelButton_Click">Админ панель</Button>
        </Grid>

        <Frame x:Name="MainFrame" Margin="0,113,0,0" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
