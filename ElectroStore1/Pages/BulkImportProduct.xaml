<Window x:Class="ElectroStore.Pages.BulkImportProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Массовое добавление товаров" 
        Height="600" 
        Width="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BackgroundLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="White" Padding="20" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Массовое добавление товаров из CSV" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Выберите CSV файл с данными о товарах для импорта" FontSize="14" Foreground="#666"/>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Button Content="📁 Выбрать CSV файл" 
                            Name="SelectFileButton"
                            Click="SelectFile_Click"
                            Width="180"
                            Height="40"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,10,0"/>

                    <TextBlock Name="FileNameText" 
                               VerticalAlignment="Center" 
                               FontSize="14"
                               Foreground="#666"
                               Text="Файл не выбран"/>
                </StackPanel>

                <CheckBox Name="SkipExistingCheckBox" 
                          Content="Пропускать существующие товары" 
                          Margin="0,10,0,0"
                          IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Предпросмотр данных -->
        <Border Grid.Row="1" Margin="20" Background="White" CornerRadius="6" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
            <Grid>
                <TextBlock Text="Выберите CSV файл для предпросмотра данных" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#999"
                           Name="PlaceholderText"/>

                <DataGrid Name="PreviewDataGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Visibility="Collapsed"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="Transparent"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          VerticalGridLinesBrush="Transparent"
                          HorizontalGridLinesBrush="{StaticResource BorderLight}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#2C3E50"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Нижняя панель с кнопками и прогрессом -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Прогресс бар -->
                <StackPanel Grid.Row="0" Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,15">
                    <TextBlock Name="ProgressText" Text="Импорт товаров..." FontSize="14" Margin="0,0,0,5"/>
                    <ProgressBar Name="ImportProgressBar" Height="20" Minimum="0" Maximum="100"/>
                    <TextBlock Name="ProgressDetailsText" Text="" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Кнопки -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="❌ Отмена" 
                            Width="120"
                            Height="40"
                            Click="Cancel_Click"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#95A5A6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7F8C8D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="✅ Импортировать" 
                            Name="ImportButton"
                            Width="150"
                            Height="40"
                            Click="Import_Click"
                            IsEnabled="False">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#229954"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC"/>
                                        <Setter Property="Foreground" Value="#666666"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
