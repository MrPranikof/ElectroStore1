<Window x:Class="ElectroStore1.Pages.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages"
        mc:Ignorable="d"
        Title="Registration" Height="600" Width="1200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid Background="{StaticResource BackgroundColor}">
        <TextBlock Text="ElectroStore" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="32" Margin="0,20,0,0" Foreground="{StaticResource TextColor}"/>
        <Grid Width="600" Height="400" Background="#F5F5F5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="20" Margin="0,4,0,-4"></Border>

            <TextBlock FontSize="24" Foreground="{StaticResource TextColor}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">Регистрация</TextBlock>
            <TextBlock Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="153,148,0,0">Логин</TextBlock>
            <TextBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,169,0,0" x:Name="LoginTextBox"></TextBox>
            <TextBlock Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="153,0,0,0">Электронная почта</TextBlock>
            <TextBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,212,0,0" x:Name="EmailTextBox"></TextBox>
            <TextBlock Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="153,235,0,0">Пароль</TextBlock>
            <TextBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,256,0,0" Visibility="Hidden" x:Name="showPassword"></TextBox>
            <PasswordBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,256,0,0" x:Name="hidePassword"></PasswordBox>
            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="20" Background="{StaticResource ButtonBackgroundColor}" BorderBrush="White" Foreground="{StaticResource ButtonTextColor}" Margin="0,300,0,0" Click="ButtonReg" IsDefault="True" FontSize="10" FontWeight="Bold">Зарегестрироваться</Button>
            <Label HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,325,0,0">
                <Hyperlink TextDecorations="None" Foreground="{StaticResource SecondaryTextColor}" NavigateUri="/Pages/Authorization.xaml" RequestNavigate="LogNav">Есть аккаунт? Войдите</Hyperlink>
            </Label>
            <Button Height="25" Width="25" Margin="464,249,111,126" Click="PasswordButtonImage" Background="White" BorderBrush="White">
                <Image Source="\Images\showpassword.png" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
            </Button>
        </Grid>
        <Button Width="0" Height="0" VerticalAlignment="Bottom" IsCancel="True" Click="ButtonEsc"></Button>
    </Grid>
</Window>
