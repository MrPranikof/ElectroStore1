<Window x:Class="ElectroStore1.Pages.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages"
        mc:Ignorable="d"
        Title="Registration" Height="600" Width="1200"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#f5f6fa">
        <!-- Фоновые элементы -->
        <Ellipse Fill="#6C5CE7" Opacity="0.08" Width="400" Height="400"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
        <Ellipse Fill="#00CEc9" Opacity="0.08" Width="300" Height="300"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>

        <!-- Заголовок приложения -->
        <TextBlock Text="ElectroStore" VerticalAlignment="Top" HorizontalAlignment="Center" 
                   FontSize="32" Foreground="{StaticResource TextColor}"
                   FontWeight="SemiBold" FontFamily="Segoe UI"/>

        <!-- Основная форма -->
        <Grid Width="650" Height="455" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Тень и скругление формы -->
            <Border CornerRadius="20" Background="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#20000000"/>
                </Border.Effect>

                <!-- Контент формы -->
                <StackPanel VerticalAlignment="Center" Margin="40">
                    <TextBlock Text="Регистрация" FontSize="24" Foreground="{StaticResource TextColor}" 
                             HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,30"/>

                    <!-- Поле логина -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Логин" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#dfe6e9" 
                                Background="#f5f6fa" Padding="2">
                            <TextBox x:Name="LoginTextBox" BorderThickness="0" Background="Transparent"
                                    Padding="10,8" FontSize="14" Foreground="#2d3436"
                                    Height="35" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Поле email -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Электронная почта" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#dfe6e9" 
                                Background="#f5f6fa" Padding="2">
                            <TextBox x:Name="EmailTextBox" BorderThickness="0" Background="Transparent"
                                    Padding="10,8" FontSize="14" Foreground="#2d3436"
                                    Height="35" VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Поле пароля -->
                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Пароль" Foreground="#636e72" FontSize="12" Margin="5,0,5,5"/>
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#dfe6e9" 
                                Background="#f5f6fa" Padding="2">
                            <Grid>
                                <PasswordBox x:Name="hidePassword" BorderThickness="0" Background="Transparent"
                                            Padding="10,8" FontSize="14" Foreground="#2d3436"
                                            Height="35" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="showPassword" BorderThickness="0" Background="Transparent"
                                        Padding="10,8" FontSize="14" Foreground="#2d3436" Visibility="Collapsed"
                                        Height="35" VerticalContentAlignment="Center"/>
                                <Button x:Name="TogglePasswordButton" Width="30" Height="30"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                                        Margin="0,0,10,0" Style="{StaticResource TransparentButton}"  
                                        Click="PasswordButtonImage">
                                    <Image Source="/Images/showpassword.png"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Кнопка регистрации -->
                    <Button Content="Зарегистрироваться" Height="42" FontSize="14" FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButton}" Click="ButtonReg" Margin="0,0,0,15"/>

                    <!-- Ссылка на авторизацию -->
                    <TextBlock HorizontalAlignment="Center" Foreground="#636e72" FontSize="13">
                        <Hyperlink TextDecorations="None" Foreground="#0984e3" 
                                  NavigateUri="/Pages/Authorization.xaml" RequestNavigate="LogNav">
                            Есть аккаунт? Войдите
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Скрытая кнопка для Esc -->
        <Button Width="0" Height="0" VerticalAlignment="Bottom" IsCancel="True" Click="ButtonEsc"/>
    </Grid>
</Window>