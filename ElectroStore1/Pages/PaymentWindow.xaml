<Window x:Class="ElectroStore.Pages.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата заказа" 
        Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Оплата картой" 
                   FontSize="22" 
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10"
                Padding="20"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Номер карты" Margin="0,0,0,5" Foreground="#666"/>
                <TextBox x:Name="CardNumberBox" 
                         Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="10"
                         MaxLength="19"
                         PreviewTextInput="CardNumberBox_PreviewTextInput"/>

                <TextBlock Text="Срок действия" Margin="0,15,0,5" Foreground="#666"/>
                <TextBox x:Name="ExpiryDateBox" 
                         Text="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="10"
                         MaxLength="5"
                         PreviewTextInput="ExpiryDateBox_PreviewTextInput"
                         ToolTip="ММ/ГГ"/>

                <TextBlock Text="CVV" Margin="0,15,0,5" Foreground="#666"/>
                <TextBox x:Name="CvvBox" 
                         Text="{Binding CVV, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="10"
                         MaxLength="3"
                         PreviewTextInput="NumberValidationTextBox"/>

                <TextBlock Text="Имя на карте" Margin="0,15,0,5" Foreground="#666"/>
                <TextBox x:Name="CardNameBox" 
                         Text="{Binding CardHolderName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="16"
                         Padding="10"/>

                <TextBlock Text="Сумма к оплате" Margin="0,15,0,5" Foreground="#666"/>
                <TextBlock Text="{Binding Amount, StringFormat='{}{0:N2} ₽'}" 
                           FontSize="18"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <Button x:Name="PayButton" 
                Grid.Row="2"
                Content="Оплатить"
                Background="#4CAF50"
                Foreground="White"
                FontSize="16"
                FontWeight="Bold"
                Padding="15,10"
                Margin="0,20,0,0"
                BorderThickness="0"
                Click="PayButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <ProgressBar x:Name="PaymentProgress" 
                     Grid.Row="2"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Margin="0,20,0,0"
                     Height="10"/>
    </Grid>
</Window>
