<Window x:Class="ElectroStore1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1"
        mc:Ignorable="d"
        Title="Авторизация" Height="600" Width="1200"
        ResizeMode="NoResize"
        >

    <Grid Background="{StaticResource BackgroundColor}">
        <TextBlock Text="ElectroStore" VerticalAlignment="Top" HorizontalAlignment="Center" FontSize="32" Margin="0,20,0,0" Foreground="{StaticResource TextColor}"/>
        <Grid Width="600" Height="400" Background="#F5F5F5" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="White" BorderBrush="White" BorderThickness="1" CornerRadius="20"></Border>

            <TextBlock FontSize="24" Foreground="{StaticResource TextColor}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,0">Вход в систему</TextBlock>
            <TextBlock Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="153,129,0,0">Логин</TextBlock>
            <TextBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,150,0,0" x:Name="LoginTextBox"></TextBox>
            <TextBlock Foreground="{StaticResource SecondaryTextColor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="153,196,0,0">Пароль</TextBlock>
            <TextBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,217,0,0" Visibility="Hidden" x:Name="showPassword"></TextBox>
            <PasswordBox HorizontalAlignment="Center" VerticalAlignment="Top" Width="300" Height="18" Margin="0,217,0,0" x:Name="hidePassword"></PasswordBox>
            <Button HorizontalAlignment="Center" VerticalAlignment="Top" Width="150" Height="20" Background="{StaticResource ButtonBackgroundColor}" BorderBrush="White" Foreground="{StaticResource TextColor}" Margin="0,280,0,0" Click="ButtonLogin" IsDefault="True">Войти</Button>
            <Label HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,305,0,0">
                <Hyperlink TextDecorations="None" Foreground="{StaticResource SecondaryTextColor}" NavigateUri="/Pages/Registration.xaml" RequestNavigate="RegistNav">Нет аккаунта? Зарегестрируйтесь</Hyperlink>
            </Label>
            <Button Height="25" Width="25" Margin="464,210,111,165" Click="PasswordButtonImage" Background="White" BorderBrush="White">
                <Image Source="\Images\showpassword.png" HorizontalAlignment="Center" VerticalAlignment="Center"></Image>
            </Button>
            <Label HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,347,0,0">
                <Hyperlink TextDecorations="None" Foreground="{StaticResource SecondaryTextColor}" NavigateUri="/Pages/Main.xaml" RequestNavigate="GuestNav">
                    <Run Text="Войти как гость"/>
                </Hyperlink>
            </Label>
        </Grid>
        <Button Width="0" Height="0" VerticalAlignment="Bottom" IsCancel="True" Click="ButtonEsc"></Button>
        <DataGrid x:Name="DG_Client" Margin="939,177,47,177" />
    </Grid>
</Window>
