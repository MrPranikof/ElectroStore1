<Window x:Class="ElectroStore1.Pages.AddProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.Pages" xmlns:views="clr-namespace:ElectroStore1.Views"
        mc:Ignorable="d"
        Title="Добавление товара" Height="450" Width="800"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        >
    <Grid Background="WhiteSmoke">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <views:AddProductView HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20"/>
        </ScrollViewer>
    </Grid>
</Window>
