<Window x:Class="ElectroStore1.LoaderFolder.LoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ElectroStore1.LoaderFolder"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        mc:Ignorable="d"
        Title="LoaderWindow" Height="300" Width="500"
        Background="Transparent"
        >

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="15" ShadowDepth="0" 
                      Color="#20000000" Opacity="0.3" Direction="270"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3A86FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#FF3A86FF"/>
            <Setter Property="Background" Value="#FFE0ECFF"/>
            <Setter Property="BorderBrush" Value="#FFB8D4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="10" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="8" Margin="1"/>
                                <Border x:Name="PART_Indicator" 
                                    CornerRadius="8" 
                                    Margin="1"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" 
                                                      ShadowDepth="0" 
                                                      Color="#803A86FF"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#FFF5F9FF" BorderBrush="#FF3A86FF" BorderThickness="2"
        Effect="{StaticResource ShadowEffect}" Padding="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" 
              Fill="#FF3A86FF" Width="60" Height="60" Margin="0,0,0,15"
              RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform Angle="0" x:Name="logoSpin"/>
                </Path.RenderTransform>
                <Path.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="logoSpin" 
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:2"
                                             RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Path.Triggers>
            </Path>

            <TextBlock Text="Загрузка приложения" Foreground="#FF1A3E72" 
                   HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,15"/>

            <ProgressBar x:Name="progressFill" 
             Minimum="0" Maximum="100" Value="0"
             Height="20" Width="350"
             Margin="0,0,0,10"
             Style="{StaticResource ModernProgressBar}"/>

            <TextBlock x:Name="tbStatus" Text="Инициализация системы..." 
                   Foreground="#FF4A6FA8" HorizontalAlignment="Center" 
                   FontSize="14" Margin="0,5,0,0">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.5" To="1" Duration="0:0:1.5"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <TextBlock Text="v1.2.2.0 · © 2025" Foreground="#FF8BA3C7" 
                   HorizontalAlignment="Center" FontSize="11" Margin="0,15,0,0"/>
        </StackPanel>
    </Border>
</Window>
